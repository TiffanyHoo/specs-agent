# LLM（OpenAI 兼容协议；未配置 CHAT_* 时自动复用下方 EMBEDDING_* 配置，同一平台）
# 可选：切换其他平台（如 DeepSeek）时填 CHAT_API_KEY / CHAT_BASE_URL
CHAT_MODEL=qwen-plus
# 思考过程模型：qwen3 系列开启 enable_thinking 后流式返回 reasoning_content
CHAT_REASONING_MODEL=qwen-plus

# Embedding（阿里云 DashScope，OpenAI 兼容模式）
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# 可插拔语料：公司知识库适配器使用环境变量引用路径（不入 git）
COMPANY_CORPUS_PATH=

# 检索参数
TOP_K=5
FINAL_K=3
